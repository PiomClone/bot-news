#!/bin/bash

echo "🚀 Запуск локальных проверок перед пушем..."

# Запускаем линтер и тесты через make
# Используем флаг -s для тишины
make check

RESULT=$?

if [ $RESULT -ne 0 ]; then
    echo ""
    echo "❌ Проверки не прошли! Пуш отменен."
    echo "Исправьте ошибки линтера или тесты и попробуйте снова."
    exit 1
fi

echo "✅ Все проверки пройдены. Отправляю код..."
exit 0
